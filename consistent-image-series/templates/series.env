# One file per series, next to its guide. Paths are relative to where gen.sh is run (or absolute).
REFS=""          # e.g. "refs/sheet.png"; leave empty only for the first anchor image
ATTR_REFS=""     # e.g. "refs/cheek-ref.png"
IDENTITY="<the guide's identity/style block, verbatim, one line>"
BACKGROUND="pure flat white #FFFFFF, completely empty, NO floor, NO cast shadow, NO vignette; the subject must not touch the image edges."
# Pale/white subject: BACKGROUND="pure flat mid grey #808080, completely empty, NO floor, NO cast shadow, NO vignette; the subject must not touch the image edges."  (cut out with BG="#808080")
# Scene series:      BACKGROUND="<the guide's scene rule: location, light, grade>"
